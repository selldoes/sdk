{
  "name": "selldoes-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Selldoes plugin SDK, CLI and scaffolder.",
  "license": "MIT",
  "homepage": "https://selldoes.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selldoes/sdk.git"
  },
  "workspaces": [
    "sdk",
    "cli",
    "create-plugin"
  ],
  "scripts": {
    "sdk:build": "npm run build --workspace @selldoes/plugin-sdk",
    "pack:all": "npm pack --workspace @selldoes/plugin-sdk --workspace @selldoes/plugin-cli --workspace create-selldoes-plugin --pack-destination dist/packages"
  }
}
