{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Workspace (SDK-dev mode)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["workspace", "--dev", "--no-open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Workspace (SDK-dev mode, open browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["workspace", "--dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Plugin preview (direct dev server)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["dev", "--dir", "${input:pluginDir}", "--open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "pluginDir",
      "type": "promptString",
      "description": "Plugin folder (relative to the workspace or absolute)",
      "default": "examples/demo-plugin"
    }
  ]
}
