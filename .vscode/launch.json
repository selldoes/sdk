{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server (example plugin)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["dev", "--dir", "${workspaceFolder}/examples/demo-plugin"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Dev server (example plugin, open browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["dev", "--dir", "${workspaceFolder}/examples/demo-plugin", "--open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Dev server (choose plugin folder)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/selldoes.mjs",
      "args": ["dev", "--dir", "${input:pluginDir}", "--open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Preview UI (Vite HMR)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dev-ui", "run", "dev"],
      "windows": { "runtimeExecutable": "npm.cmd" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full preview (server + UI HMR)",
      "configurations": ["Dev server (example plugin)", "Preview UI (Vite HMR)"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "pluginDir",
      "type": "promptString",
      "description": "Plugin folder (relative to the workspace or absolute)",
      "default": "examples/demo-plugin"
    }
  ]
}
